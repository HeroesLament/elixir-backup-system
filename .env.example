# Proxmox Virtual Environment (PVE) - Source of backups
PVE_HOST=virt-2.admin.siliconiq.com
PVE_PORT=8006
PVE_TOKEN_ID=root@pam!ebs-backup
PVE_TOKEN_SECRET=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

# Proxmox Backup Server (PBS) - Destination (optional for now)
# EBS will eventually BE the backup server, but can also use existing PBS
PBS_HOST=pbs.example.com
PBS_PORT=8007
PBS_USER=root@pam
PBS_PASSWORD=your-password-here

# Storage Configuration
BACKUP_STORAGE_TYPE=local
BACKUP_STORAGE_PATH=/mnt/backups

# S3 Configuration (for cold storage tiering)
S3_ENDPOINT=https://s3.amazonaws.com
S3_BUCKET=my-backup-archive
S3_ACCESS_KEY=your-access-key
S3_SECRET_KEY=your-secret-key

# Database
EBS_DB_PATH=/var/lib/ebs/backups.sqlite3

# Logging
LOG_LEVEL=info
STRUCTURED_LOGGING=false
